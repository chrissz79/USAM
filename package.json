{
  "name": "usam",
  "version": "0.1.0",
  "description": "USAM - Universal Sound Asset Manager",
  "private": true,
  "main": "dist/backend/main.js",
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.node.json -w\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "electron .",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:main",
    "package": "electron-builder",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "better-sqlite3": "^8.3.0",
    "electron": "^29.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/electron": "^29.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "electron-builder": "^24.6.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.1"
  },
  "build": {
    "appId": "com.example.usam",
    "files": [
      "dist/**",
      "package.json"
    ]
  }
}
